---
/**
 * /agir/partenariat — références : bailleurs et partenaires de mise en œuvre (logos réels,
 * src/data/partners.ts), en deux groupes, sur fond Coton (Prosper /partners, grille de logos 9 col.).
 */
import AgirLogos from './AgirLogos.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { partners } from '../../data/partners';
import './PartnerReferences.css';

const groups = [
  { id: 'bailleur' as const, title: 'Bailleurs', text: 'Institutions qui ont financé des projets mis en œuvre par APSUD.' },
  { id: 'partenaire' as const, title: 'Partenaires de mise en œuvre', text: 'Agences des Nations unies, ONG internationales et nationales avec lesquelles APSUD a travaillé.' },
].map((g) => ({ ...g, count: partners.filter((p) => p.category === g.id).length }))
  .filter((g) => g.count > 0);
---

<section class="c-partner-refs l-section t-coton" aria-labelledby="partner-refs-title">
  <div class="l-constrain">
    <header class="c-partner-refs__head" data-reveal>
      <h2 id="partner-refs-title" class="c-partner-refs__title">Ils nous ont fait confiance</h2>
      <p class="u-lead">Des bailleurs institutionnels et des organisations internationales qui connaissent le travail d’APSUD.</p>
    </header>
    {groups.map((g) => (
      <div class="c-partner-refs__group" data-reveal>
        <div class="c-partner-refs__group-head">
          <h3 class="c-partner-refs__group-title">{g.title} <span class="c-partner-refs__count">{g.count}</span></h3>
          <p class="c-partner-refs__group-text">{g.text}</p>
        </div>
        <AgirLogos category={g.id} label={g.title} />
      </div>
    ))}
    <p class="c-partner-refs__more"><ArrowLink href="/partenaires">Voir les fiches des partenaires</ArrowLink></p>
  </div>
</section>
