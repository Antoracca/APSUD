---
/**
 * /faire-un-don — module de don (gabarit E de Prosper, colonne droite `c-donation-form`).
 * Étape 3 « Moyen de paiement » (2026-11-22) : Orange Money ou carte bancaire. « Procéder au paiement »
 * mène à la page du moyen choisi avec le montant et la devise (/faire-un-don/orange-money?montant=…&devise=…,
 * aucune donnée personnelle dans l'URL). Front-end seulement : aucun débit tant que le back-end
 * (agrégateur, Stripe ou passerelle) n'est pas branché. Aucune coordonnée APSUD n'est publiée.
 *
 * Sans JS : radios natifs, bascule de devise en CSS (:has), lien vers /contact?objet=don.
 * Avec JS (src/scripts/donate.ts) : récapitulatif en direct, champ « autre montant », lien enrichi.
 * Innovation APSUD : la puce choisie prend la forme de la goutte-feuille (coin vif en bas à gauche).
 * TODO back-end : brancher ici un paiement en ligne (CinetPay, Flutterwave…) sans changer la structure.
 */
import { Image } from 'astro:assets';
import Button from '../../components/ui/Button.astro';
import CardBrand from '../../components/ui/CardBrand.astro';
import { getImage } from '../../lib/images';
import { paymentMethods, cardBrands, orangeMoneyLogo } from '../paiement/paymentData';
import Icon from '../../components/ui/Icon.astro';
import { site, telHref } from '../../data/site';
import { donationAmounts } from './agirData';
import './DonatePanel.css';

const nf = new Intl.NumberFormat('fr-FR');
const currencies = Object.values(donationAmounts);
const first = currencies[0];
const tel = site.contact.telephones[0];
const omLogo = getImage(orangeMoneyLogo);
---

<aside class="c-donate-panel" aria-labelledby="don-panel-title" data-donate>
  <div class="c-donate-panel__head t-foret">
    <h2 id="don-panel-title" class="c-donate-panel__title">Préparer mon don</h2>
    <p class="c-donate-panel__intro">Choisissez un montant et votre moyen de paiement&nbsp;: Orange Money ou carte bancaire.</p>
  </div>

  <div class="c-donate-panel__body">
    <fieldset class="c-donate-step">
      <legend class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">1</span> Devise</legend>
      <div class="c-donate-switch">
        {currencies.map((c, i) => (
          <label class="c-donate-switch__option">
            <input class="c-donate-switch__input" type="radio" name="devise" value={c.code} id={`don-devise-${c.code.toLowerCase()}`} checked={i === 0} data-label={c.label} data-donate-currency />
            <span class="c-donate-switch__label">{c.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="c-donate-step">
      <legend class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">2</span> Montant</legend>
      {currencies.map((c) => (
        <div class="c-donate-amounts" data-currency={c.code}>
          {c.values.map((v) => (
            <label class="c-donate-chip">
              <input class="c-donate-chip__input" type="radio" name={`montant-${c.code}`} value={v} checked={v === c.default} data-donate-amount />
              <span class="c-donate-chip__label">{nf.format(v)}<span class="c-donate-chip__unit">&nbsp;{c.label}</span></span>
            </label>
          ))}
        </div>
      ))}
      <div class="c-donate-other">
        <label class="c-donate-other__label" for="don-autre">Autre montant <span class="c-donate-other__hint">(facultatif)</span></label>
        <div class="c-donate-other__field">
          <input class="c-donate-other__input" id="don-autre" type="number" inputmode="numeric" min="1" step="1" autocomplete="off" data-donate-other />
          <span class="c-donate-other__unit" aria-hidden="true" data-donate-unit>{first.label}</span>
        </div>
      </div>
    </fieldset>

    <fieldset class="c-donate-step">
      <legend class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">3</span> Moyen de paiement</legend>
      <div class="c-donate-methods">
        {paymentMethods.map((m, i) => (
          <label class={`c-donate-method c-donate-method--${m.id}`}>
            <input class="c-donate-method__input" type="radio" name="paiement" value={m.id} checked={i === 0} data-href={m.href} data-donate-method />
            <span class="c-donate-method__visual" aria-hidden="true">
              {m.id === 'orange-money' ? (
                <Image src={omLogo} alt="" width={240} height={Math.round((240 * omLogo.height) / omLogo.width)} format="webp" class="c-donate-method__om" />
              ) : (
                <span class="c-donate-method__brands">
                  {cardBrands.slice(0, 3).map((b) => <CardBrand icon={b.icon} />)}
                </span>
              )}
            </span>
            <span class="c-donate-method__text">
              <span class="c-donate-method__title">{m.title}</span>
              <span class="c-donate-method__desc">{m.text}</span>
            </span>
            <span class="c-donate-method__check" aria-hidden="true"><Icon name="check" size="sm" /></span>
          </label>
        ))}
      </div>
    </fieldset>

    <p class="c-donate-summary" aria-live="polite">
      Votre don&nbsp;: <output class="c-donate-summary__value" data-donate-summary>{nf.format(first.default)}&nbsp;{first.label}</output>
    </p>

    <Button href={paymentMethods[0].href} variant="donate" size="lg" class="c-donate-panel__cta" data-donate-cta>
      Procéder au paiement
      <Icon name="arrow-right" />
    </Button>

    <p class="c-donate-panel__legal">
      <Icon name="cadenas" size="sm" />
      <span>Paiement en ligne en cours de mise en service&nbsp;: aucun montant n’est encore débité.</span>
    </p>
    <p class="c-donate-panel__alt">
      Vous préférez appeler&nbsp;? <a href={telHref(tel)}>{tel}</a>
    </p>
  </div>
</aside>

<script>
  import '../../scripts/donate';
</script>
