---
/**
 * /faire-un-don — module de don (gabarit E de Prosper, colonne droite `c-donation-form`).
 * NON transactionnel : APSUD n'a publié aucune modalité (organisation.json › don) ; on ne
 * publie ni numéro Mobile Money, ni IBAN, ni RIB. Le module prépare une intention de don
 * (devise + montant indicatif) et la transmet au formulaire de contact
 * (/contact?objet=don&montant=…&devise=…), où APSUD répond avec ses coordonnées.
 *
 * Sans JS : radios natifs, bascule de devise en CSS (:has), lien vers /contact?objet=don.
 * Avec JS (src/scripts/donate.ts) : récapitulatif en direct, champ « autre montant », lien enrichi.
 * Innovation APSUD : la puce choisie prend la forme de la goutte-feuille (coin vif en bas à gauche).
 * TODO back-end : brancher ici un paiement en ligne (CinetPay, Flutterwave…) sans changer la structure.
 */
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { site, telHref } from '../../data/site';
import { donationAmounts } from './agirData';
import './DonatePanel.css';

const nf = new Intl.NumberFormat('fr-FR');
const currencies = Object.values(donationAmounts);
const first = currencies[0];
const tel = site.contact.telephones[0];
---

<aside class="c-donate-panel" aria-labelledby="don-panel-title" data-donate>
  <div class="c-donate-panel__head t-foret">
    <h2 id="don-panel-title" class="c-donate-panel__title">Préparer mon don</h2>
    <p class="c-donate-panel__intro">Choisissez un montant indicatif&nbsp;: APSUD vous communique ensuite ses coordonnées de paiement.</p>
  </div>

  <div class="c-donate-panel__body">
    <fieldset class="c-donate-step">
      <legend class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">1</span> Devise</legend>
      <div class="c-donate-switch">
        {currencies.map((c, i) => (
          <label class="c-donate-switch__option">
            <input class="c-donate-switch__input" type="radio" name="devise" value={c.code} id={`don-devise-${c.code.toLowerCase()}`} checked={i === 0} data-label={c.label} data-donate-currency />
            <span class="c-donate-switch__label">{c.label}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <fieldset class="c-donate-step">
      <legend class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">2</span> Montant indicatif</legend>
      {currencies.map((c) => (
        <div class="c-donate-amounts" data-currency={c.code}>
          {c.values.map((v) => (
            <label class="c-donate-chip">
              <input class="c-donate-chip__input" type="radio" name={`montant-${c.code}`} value={v} checked={v === c.default} data-donate-amount />
              <span class="c-donate-chip__label">{nf.format(v)}<span class="c-donate-chip__unit">&nbsp;{c.label}</span></span>
            </label>
          ))}
        </div>
      ))}
      <div class="c-donate-other">
        <label class="c-donate-other__label" for="don-autre">Autre montant <span class="c-donate-other__hint">(facultatif)</span></label>
        <div class="c-donate-other__field">
          <input class="c-donate-other__input" id="don-autre" type="number" inputmode="numeric" min="1" step="1" autocomplete="off" data-donate-other />
          <span class="c-donate-other__unit" aria-hidden="true" data-donate-unit>{first.label}</span>
        </div>
      </div>
    </fieldset>

    <div class="c-donate-step">
      <p class="c-donate-step__legend"><span class="c-donate-step__num" aria-hidden="true">3</span> Modalités</p>
      <ul class="c-donate-ways" role="list">
        <li class="c-donate-ways__item">
          <span class="c-donate-ways__icon" aria-hidden="true"><Icon name="phone" /></span>
          <span><strong>Mobile Money</strong><br />Coordonnées communiquées par APSUD sur demande.</span>
        </li>
        <li class="c-donate-ways__item">
          <span class="c-donate-ways__icon" aria-hidden="true"><Icon name="don" /></span>
          <span><strong>Virement bancaire</strong><br />Coordonnées communiquées par APSUD sur demande.</span>
        </li>
      </ul>
    </div>

    <p class="c-donate-summary" aria-live="polite">
      Votre intention de don&nbsp;: <output class="c-donate-summary__value" data-donate-summary>{nf.format(first.default)}&nbsp;{first.label}</output>
    </p>

    <Button href="/contact?objet=don" variant="donate" size="lg" class="c-donate-panel__cta" data-donate-cta>
      Demander les coordonnées
    </Button>

    <p class="c-donate-panel__legal">
      <Icon name="check" size="sm" />
      <span>Montants purement indicatifs&nbsp;: aucun paiement n’est effectué sur ce site.</span>
    </p>
    <p class="c-donate-panel__alt">
      Vous préférez appeler&nbsp;? <a href={telHref(tel)}>{tel}</a>
    </p>
  </div>
</aside>

<script>
  import '../../scripts/donate';
</script>
