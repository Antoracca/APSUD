---
/**
 * Accueil §6 — Projets réalisés (équivalent « From the press room » de Prosper).
 * PROSPER_STRUCTURE §5.1 (6) et §4.3 (c-tile) ; DESIGN.md §4.13.
 * H2 aligné à gauche → 3 tuiles texte en colonnes (≥ 48em) → bouton contour vers le listing.
 */
import Tile from '../../components/ui/Tile.astro';
import Button from '../../components/ui/Button.astro';
import { recentProjects } from '../../data/home';
import './HomeRecentProjects.css';
---

<section class="c-home-recent l-section" aria-labelledby="home-recent-title">
  <div class="l-constrain">
    <h2 id="home-recent-title" class="c-home-recent__title" data-reveal>{recentProjects.title}</h2>
    <ul class="c-home-recent__grid" role="list">
      {recentProjects.items.map((item, i) => (
        <li class="c-home-recent__item" data-reveal data-reveal-delay={String(i * 150)}>
          <Tile
            href={item.href}
            date={item.date}
            place={item.place}
            title={item.title}
            text={item.text}
            linkLabel="Lire la fiche"
          />
        </li>
      ))}
    </ul>
    <div class="c-home-recent__cta" data-reveal>
      <Button href={recentProjects.cta.href} variant="outline">{recentProjects.cta.label}</Button>
    </div>
  </div>
</section>
