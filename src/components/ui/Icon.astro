---
/**
 * Icône SVG maison (src/icons/*.svg), insérée en ligne pour hériter de `currentColor`.
 * Grille 24 px, trait 2 px, extrémités rondes (DESIGN.md §3).
 * Décorative par défaut (aria-hidden). Passer `label` pour une icône porteuse de sens.
 */
import './Icon.css';

interface Props {
  name: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  label?: string;
  class?: string;
}

const icons = import.meta.glob<string>('../../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, size = 'md', label, class: className } = Astro.props;
const raw = icons[`../../icons/${name}.svg`];
if (!raw) throw new Error(`Icône introuvable : src/icons/${name}.svg`);
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"';
const svg = raw.replace(/<\?xml[^>]*>/, '').replace('<svg', `<svg focusable="false" ${a11y}`);
---

<span class:list={['c-icon', `c-icon--${size}`, className]} set:html={svg} />
